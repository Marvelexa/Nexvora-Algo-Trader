# System 3005 Server & Delta Exchange Configuration
PORT=3005
NODE_ENV="development"

# Delta Exchange Trading Mode: DELTA_TESTNET | LIVE_DELTA_INDIA | LIVE_DELTA_GLOBAL | SIMULATION_PAPER
DELTA_TRADING_MODE="DELTA_TESTNET"
DELTA_IS_TESTNET="true"
DELTA_IS_SIMULATION="false"
PAPER_TRADING="false"
DELTA_BASE_URL="https://cdn-ind.testnet.deltaex.org"
DELTA_WS_URL="wss://socket-ind.testnet.deltaex.org"

# Delta Exchange API Credentials (Configure here or via UI -> saved locally in .exchange_credentials.json)
DELTA_API_KEY=""
DELTA_API_SECRET=""
EXCHANGE_API_KEY=""
EXCHANGE_API_SECRET=""

# Capital Allocation (INR / USD)
INITIAL_CAPITAL_INR="15000"

# GEMINI_API_KEY: Optional for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: Application URL.
APP_URL="http://localhost:3005"

